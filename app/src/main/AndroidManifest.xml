<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        响铃胶囊：悬浮在其他应用上层（app/src/main/java/phoenix/smsnotify/important/RingIsland.kt）。
        这是特殊权限，安装后默认是「不允许」，必须由用户在系统设置里手动打开 ——
        没打开时一切照常，只是没有胶囊，退回通知栏那条。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        息屏/锁屏时点亮屏幕并盖住锁屏（important/AlarmActivity）。

        Android 14（API 34）起这不是「声明了就有效」的普通权限：默认只授予通话/闹钟类
        应用，其余应用要被用户在「特殊权限 → 全屏通知」里手动打开，否则系统会静默忽略
        通知上的全屏 intent（声音照响、屏幕不亮，也没有任何报错）。
        代码里用 NotificationManager.canUseFullScreenIntent() 查询状态，
        设置页给了跳转入口，见 ImportantNotify.canFullScreen。
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- App 只做一件事：把各功能模块注册到短信分发中心 -->
    <application
        android:name=".App"
        android:label="短信提醒助手"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- ===== 主页：底部导航的宿主，下挂「快递服务」「重要短信提醒」两屏 ===== -->
        <!-- singleTop：从通知点进来时复用同一个实例，直接切 Tab，而不是重开一页 -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ===== 快递功能（delivery 包） ===== -->
        <!-- 规则列表：由快递页标题栏的书页图标进入 -->
        <activity android:name=".delivery.RulesActivity" android:exported="false" />
        <activity android:name=".delivery.RuleEditActivity"
            android:windowSoftInputMode="adjustResize" android:exported="false" />

        <!-- ===== 重要短信提醒（important 包） ===== -->
        <activity android:name=".important.ImportantRulesActivity" android:exported="false" />
        <activity android:name=".important.ImportantRuleEditActivity"
            android:windowSoftInputMode="adjustResize" android:exported="false" />

        <!--
            全屏提醒页：只在息屏/锁屏时由通知的全屏 intent 拉起，不对外暴露。

            taskAffinity="" + excludeFromRecents：让它待在独立任务里，不混进主页那摞栈，
            停止后 finish 直接回锁屏 —— 而不是把 MainActivity 顶到用户脸上。
            showWhenLocked / turnScreenOn 是「锁屏上显示 + 点亮屏幕」的声明式写法，
            AlarmActivity 里还有对应的代码设置（部分 ROM 只认其中一种）。
        -->
        <activity
            android:name=".important.AlarmActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- ===== 设置（settings 包）：底部导航第三栏里的子页 ===== -->
        <activity android:name=".settings.AboutActivity" android:exported="false" />

        <!-- 通知上的「停止响铃」和划掉通知都发到这里：只由本应用的 PendingIntent 触发，不对外开放 -->
        <receiver
            android:name=".important.StopRingReceiver"
            android:exported="false" />

        <!-- ===== 公共的短信读取层（sms 包）：与具体功能无关 ===== -->
        <!-- 只允许系统发送该广播，防止第三方伪造取件短信 -->
        <receiver
            android:name=".sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
